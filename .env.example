# Gemini API Key (managed via AI Studio Settings > Secrets)
GEMINI_API_KEY=
PORT=3000

# Security and JWT
JWT_SECRET=
ALLOWED_ORIGIN=

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Supabase Database Configuration (PostgreSQL connection string or URL/Key)
# Option 1: Direct or Pooler Database URL (Settings > Database > Connection string)
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Option 2: Supabase API URL & Keys (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
